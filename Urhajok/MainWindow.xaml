<Window x:Class="Urhajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urhajok"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Background="#FF000048" Grid.Column="0">
            <Label Foreground="White" FontSize="20" FontWeight="Bold" >Űrhajó műveletek</Label>
            <Button x:Name="betolt" Content="Adatok betöltése" Height="20" Margin="10" Click="betolt_Click"/>
            <Button x:Name="urhajokszama" Content="Hány űrhajó van?" Height="20" Margin="10" Click="urhajokszama_Click"/>
            <Button x:Name="hatotav" Content="Melyiknek a legnagyobb a hatótávja?" Height="20" Margin="10" Click="hatotav_Click"/>
            <Button x:Name="kuldetes" Content="Kik voltak sikeres küldetésen?" Height="20" Margin="10" Click="kuldetes_Click"/>
            <Button x:Name="atlag" Content="Átlagos legénységszám" Height="20" Margin="10" Click="atlag_Click"/>
            <Button x:Name="gyartok" Content="Gyártók szerinti csoportosítás" Height="20" Margin="10" Click="gyartok_Click"/>
            <Button x:Name="kereses" Content="Keresés név alapján" Height="20" Margin="10" Click="kereses_Click"/>
            <Label Foreground="White" FontSize="15" FontWeight="Bold" >Keresett név</Label>
            <TextBox x:Name="keresettNev"></TextBox>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <DataGrid x:Name="datagrid"></DataGrid>
        </StackPanel>
    </Grid>
</Window>
